# ---- Database (one database for the whole shipment lifecycle) ----
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSLMODE=require            # "disable" for the local docker-compose database
# Local docker-compose only (docker-compose.yml)
# POSTGRES_USER=t3ra
# POSTGRES_PASSWORD=

# ---- Turvo (read-only API) ----
TURVO_BASE_URL=https://publicapi.turvo.com
TURVO_CLIENT_ID=publicapi
TURVO_CLIENT_SECRET=
TURVO_API_KEY=
TURVO_USERNAME=
TURVO_PASSWORD=

# ---- Webhook (must equal the token on the Turvo webhook profile) ----
TURVO_WEBHOOK_SHARED_TOKEN=
WEBHOOK_PATH=/webhooks/turvo

# ---- Covered phase (same COVERED_* names as the old covered_loads .env; the plain name, e.g. GS_CLIENT_ID, also works) ----
COVERED_GS_ENABLED=true
COVERED_GS_CLIENT_ID=
COVERED_GS_CLIENT_SECRET=
COVERED_DAT_ENABLED=true
COVERED_DAT_ENV=prod
COVERED_DAT_ORG_USERNAME=
COVERED_DAT_ORG_PASSWORD=
COVERED_DAT_USER_USERNAME=
COVERED_DAT_USER_PASSWORD=

# ---- Dashboard API ----
COVERED_DASHBOARD_API_TOKEN=
COVERED_DASHBOARD_CORS_ORIGINS=

# ---- Optional ----
TEAMS_WEBHOOK_URL=
COVERED_LOGFIRE_TOKEN=
COVERED_WORKER_BATCH_SIZE=20
COVERED_WORKER_SLEEP_SECONDS=10
COVERED_REFRESH_INTERVAL_MINUTES=30

# Postgres
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
TABLE_NAME=route_complete_shipments

# Turvo API
TURVO_BASE_URL=https://publicapi.turvo.com
TURVO_CLIENT_ID=
TURVO_CLIENT_SECRET=
TURVO_API_KEY=
TURVO_USERNAME=
TURVO_PASSWORD=
# Shared token cache: all processes reuse one login instead of each doing their own.
TOKEN_CACHE_PATH=
# Seconds to suppress logins after Turvo rejects the credentials (lockout guard).
AUTH_COOLDOWN_SECONDS=900

# Queue retention (optional - defaults shown)
# Null out payloads on completed events after this many days.
QUEUE_PAYLOAD_RETENTION_DAYS=30
# Delete completed events after this many days. Failed ('dead') events are kept.
QUEUE_EVENT_RETENTION_DAYS=90

# Webhook
WEBHOOK_SHARED_TOKEN=
WEBHOOK_PATH=/webhooks/turvo

# Monitoring (optional - only needed by healthcheck.py)
TEAMS_WEBHOOK_URL=

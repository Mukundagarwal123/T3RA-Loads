# Install: sudo cp deploy/t3ra-worker.service /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl restart t3ra-worker
[Unit]
Description=T3RA Turvo queue worker
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/app
ExecStart=/home/ubuntu/app/.venv/bin/python -m turvo_db.worker
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
